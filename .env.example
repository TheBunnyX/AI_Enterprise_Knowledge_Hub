# Copy with scripts/setup-env.ps1 to generate local secrets. Never commit .env.
POSTGRES_PASSWORD=replace-with-random-secret
S3_ACCESS_KEY=replace-with-random-access-key
S3_SECRET_KEY=replace-with-random-secret
WEB_ORIGIN=http://localhost:3009
# Address the web port is published on. 127.0.0.1 keeps it on this machine; use the server's LAN address
# (for example 192.168.1.12) when a Cloudflare tunnel or proxy on another machine must reach http://<that address>:3009.
# Never 0.0.0.0 on a server with a public address. With a tunnel, WEB_ORIGIN must be the public https:// address.
WEB_BIND=127.0.0.1
# First-start data seed: URL of an encrypted .akh backup (Admin > Backups > download). Restored only into an EMPTY database.
# Needs the same SECRETS_KEY / BACKUP_ENCRYPTION_KEY / POSTGRES_PASSWORD as the source. Token is sent as a Bearer header.
SEED_BACKUP_URL=
SEED_BACKUP_TOKEN=
# Optional real LLM gateway; internal URL should include /v1 when required.
LITELLM_URL=
LITELLM_KEY=
# Fernet key (URL-safe base64, 32 random bytes). scripts/setup-env.ps1 generates it.
SECRETS_KEY=
MEDIA_DOWNLOAD_HOSTS=
# OpenRouter gateway (needs LITELLM_KEY=sk-or-...). Free embedding model: 4096 dims, 32k context (multi-input Thai batches fail upstream, so batch size 1); requests may be retained/used for training by the provider.
# LITELLM_URL=https://openrouter.ai/api/v1
# EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-8b:free
# EMBEDDING_DIMENSIONS=4096
# EMBEDDING_BATCH_SIZE=1
# Local ONNX model, no gateway needed (downloads ~470 MB on first use). Re-index documents after changing.
EMBEDDING_MODEL=local:multilingual-e5-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_VERSION=1
# local:bge-reranker-v2-m3 = INT8 ONNX cross-encoder on CPU (571 MB, downloaded on first use); RERANK_MIN_SCORE optional 0..1
RERANK_MODEL=
# Measured on eval/questions.jsonl: off-topic questions score <= 0.003, in-scope answers keep 99% at 0.01 but only 91% at 0.1.
RERANK_MIN_SCORE=0.003
# English questions over Thai documents: translate the question to Thai before searching (one short model call), and let the reranker judge more candidates
QUERY_TRANSLATION=false
CROSS_LANGUAGE_SEARCH=true
# OpenRouter serves one model through several companies at different prices. price = cheapest first (others stay as fallback);
# throughput or latency = fastest; empty = OpenRouter's own load balancing. Applies to chat, web-search and agent requests.
OPENROUTER_SORT=price
# Multimodal RAG (needs GOOGLE_AI_API_KEY). Pictures in PDFs and uploaded images are described by a vision model, embedded in a
# multimodal vector space, searched together with the text, and shown to vision-capable answering models.
# Privacy: when on, pictures and the text of questions are sent to Google AI. Re-index existing documents after switching it on.
MULTIMODAL_RAG=false
# MM_CAPTION_MODEL=gemini-3.5-flash-lite
# MM_EMBED_MODEL=gemini-embedding-2
# MM_EMBED_DIMS=768
# MM_MAX_IMAGES=12      pictures indexed per document
# MM_MIN_SCORE=0.38     minimum picture similarity (question text vs picture) to be a candidate
# MM_ANSWER_IMAGES=2    pictures sent to the answering model
# Local LLM (Qwen3.5-2B Q4_K_M on llama.cpp, CPU): set COMPOSE_PROFILES=llm-local, then register a model with provider "Local LLM", api_id qwen3.5-2b
# COMPOSE_PROFILES=llm-local
OCR_LANGUAGES=tha+eng

BACKUP_INTERVAL_HOURS=168
BACKUP_RETENTION=7
# Optional separate stable secret; falls back to SECRETS_KEY. Keep this key with off-site backups.
BACKUP_ENCRYPTION_KEY=

# Max characters of attached files sent to the LLM per question (shared across files; keep small for the local 8k-context model)
CHAT_ATTACHMENT_CHARS=12000

# API key ของผู้ให้บริการโมเดล (ชื่อผู้ให้บริการ + _API_KEY) ค่าใน .env มีผลก่อนค่าที่บันทึกในหน้าเว็บ
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=

# Client IP recording. Without a reverse proxy leave both unset (the web server records the socket address).
# Behind nginx/Caddy/a load balancer that sets X-Forwarded-For: set WEB_BEHIND_PROXY=1 and TRUSTED_PROXY_HOPS=2.
WEB_BEHIND_PROXY=0
TRUSTED_PROXY_HOPS=1

# What a DEPARTMENT_ADMIN may do (Super Admins always may). true/false, default true.
# Change the password of an internal account in their department:
DEPARTMENT_ADMIN_RESET_PASSWORD=true
# Manage users in their department (add, rename, suspend, quota, add/remove members).
# Setting this to false also turns off password resets, whatever the switch above says:
DEPARTMENT_ADMIN_MANAGE_USERS=false

# Languages the voice features may use (comma separated ISO codes). Default th,en.
VOICE_LANGUAGES=th,en

# Hours a temporary chat attachment is kept before the hourly cleanup deletes it
CHAT_ATTACHMENT_HOURS=24

# Agent mode: total tokens (all rounds of one question) after which the model must stop calling tools and answer
AGENT_MAX_TOKENS=60000

# How long a sign-in lasts, counted from the moment of signing in (hours; default 24, allowed 0.25 to 720).
# SESSION_HOURS=24

# Langfuse tracing (optional). Switch with `scripts/langfuse.sh on|off`, which edits this line and starts/stops the Langfuse containers.
LANGFUSE_ENABLED=false

# ClamAV virus scanning: true = on (default), false = off (uploads are not scanned and the ClamAV container idles).
# Apply with `docker compose ... up -d`, or use `scripts/clamav.sh on|off` (which also removes the container).
CLAMAV_ENABLED=true

# --- Tuning for a small CPU (example: Intel i5-6500, 4 cores / 4 threads, no hyper-threading) ---
# The API, the 2 Celery workers and the local LLM share 4 cores, so keep the busy threads near 4. These are the defaults.
# ONNX_THREADS=2              threads per ONNX session (embedding / reranker)
# ONNX_BATCH_SIZE=8           embedding batch (smaller batches fit the CPU cache); ONNX_RERANK_BATCH_SIZE=2
# CELERY_CONCURRENCY=1        ingestion tasks at the same time (1 = low RAM; 2 for a machine with 8 GB or more)
# LLM_LOCAL_THREADS=3         llama.cpp threads, one core stays free for the API
# LLM_LOCAL_IDLE_SECONDS=300  the local model leaves RAM after this many idle seconds and loads on the next request (0 = keep loaded)
# SPARSE_INDEX_MIN_CHUNKS=5000  BM25 uses the PostgreSQL term index from this many chunks upward (0 = always, a huge value = never)
# TERM_STOP_RATIO=0.5         terms in more than this share of chunks leave the BM25 term index (corpora above SPARSE_INDEX_MIN_CHUNKS; 0 = keep all)
# QDRANT_QUANTIZE=true        int8 scalar quantization of vectors (about a quarter of the RAM)
# QUERY_EMBED_CACHE_SECONDS=86400  a repeated question reuses its embedding from Redis (local embedding model); 0 = off
# CROSS_LANGUAGE_POOL=10      candidates the reranker judges for a question in another language than the passages
# POSTGRES_SHARED_BUFFERS=512MB  POSTGRES_CACHE_SIZE=2GB   PostgreSQL memory; raise them on a machine with more RAM
# BACKUP_INTERVAL_HOURS=168   one backup every 7 days (BACKUP_RETENTION=7 keeps seven weeks)
# RERANK_TOP_MIN=0            when the best passage scores below this (0..1) the question gets no evidence and chat answers "not found". Off by default:
#                             on the eval set 13% of real questions score under 0.3 while an off-topic question with matching numbers can score 0.4.

# Gemini Decision 1 (Google AI Studio Decisions API), off by default. Needs GOOGLE_AI_API_KEY (or a Google AI key saved in the web page).
# When on it (1) drops the evidence when the passages do not answer the question, (2) checks which passage supports each cited statement,
# (3) GET /api/documents/{id}/suggest-library names the best knowledge base. Any failure falls back to the local method for two minutes.
# Privacy: questions and passages are sent to Google AI while it is on. Free tier 200 RPM / 10,000 RPD; paid input about $0.10 per 1M tokens.
# DECISIONS_ENABLED=true
# DECISIONS_MODEL=gemini-decision-1   Google AI (GOOGLE_AI_API_KEY). Through OpenRouter (OPENROUTER_API_KEY, alpha API): typesafe/jev-1.14, typesafe/jev-1.13, perplexity/pplx-decider-v1.2
#                                     An id without "/" goes to Google AI, one with "/" to OpenRouter. The main gateway key is never used for this.
# DECISIONS_RELEVANCE_MIN=0.25   evidence is dropped when the probability that it answers the question is below this
# DECISIONS_SUGGEST_MIN=0.6      minimum confidence for a library suggestion

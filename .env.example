# Copy with scripts/setup-env.ps1 to generate local secrets. Never commit .env.
POSTGRES_PASSWORD=replace-with-random-secret
S3_ACCESS_KEY=replace-with-random-access-key
S3_SECRET_KEY=replace-with-random-secret
WEB_ORIGIN=http://localhost:3009
# Optional real LLM gateway; internal URL should include /v1 when required.
LITELLM_URL=
LITELLM_KEY=
# Fernet key (URL-safe base64, 32 random bytes). scripts/setup-env.ps1 generates it.
SECRETS_KEY=
MEDIA_DOWNLOAD_HOSTS=
# OpenRouter gateway (needs LITELLM_KEY=sk-or-...). Free embedding model: 4096 dims, 32k context (multi-input Thai batches fail upstream, so batch size 1); requests may be retained/used for training by the provider.
# LITELLM_URL=https://openrouter.ai/api/v1
# EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-8b:free
# EMBEDDING_DIMENSIONS=4096
# EMBEDDING_BATCH_SIZE=1
# Local ONNX model, no gateway needed (downloads ~470 MB on first use). Re-index documents after changing.
EMBEDDING_MODEL=local:multilingual-e5-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_VERSION=1
# local:bge-reranker-v2-m3 = INT8 ONNX cross-encoder on CPU (571 MB, downloaded on first use); RERANK_MIN_SCORE optional 0..1
RERANK_MODEL=
# Measured on eval/questions.jsonl: off-topic questions score <= 0.003, in-scope answers keep 99% at 0.01 but only 91% at 0.1.
RERANK_MIN_SCORE=0.003
# English questions over Thai documents: translate the question to Thai before searching (one short model call), and let the reranker judge more candidates
QUERY_TRANSLATION=true
CROSS_LANGUAGE_SEARCH=true
# OpenRouter serves one model through several companies at different prices. price = cheapest first (others stay as fallback);
# throughput or latency = fastest; empty = OpenRouter's own load balancing. Applies to chat, web-search and agent requests.
OPENROUTER_SORT=price
# Multimodal RAG (needs GOOGLE_AI_API_KEY). Pictures in PDFs and uploaded images are described by a vision model, embedded in a
# multimodal vector space, searched together with the text, and shown to vision-capable answering models.
# Privacy: when on, pictures and the text of questions are sent to Google AI. Re-index existing documents after switching it on.
MULTIMODAL_RAG=false
# MM_CAPTION_MODEL=gemini-3.5-flash-lite
# MM_EMBED_MODEL=gemini-embedding-2
# MM_EMBED_DIMS=768
# MM_MAX_IMAGES=12      pictures indexed per document
# MM_MIN_SCORE=0.38     minimum picture similarity (question text vs picture) to be a candidate
# MM_ANSWER_IMAGES=2    pictures sent to the answering model
# Local LLM (Qwen3.5-2B Q4_K_M on llama.cpp, CPU): set COMPOSE_PROFILES=llm-local, then register a model with provider "Local LLM", api_id qwen3.5-2b
# COMPOSE_PROFILES=llm-local
OCR_LANGUAGES=tha+eng

BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=7
# Optional separate stable secret; falls back to SECRETS_KEY. Keep this key with off-site backups.
BACKUP_ENCRYPTION_KEY=

# Max characters of attached files sent to the LLM per question (shared across files; keep small for the local 8k-context model)
CHAT_ATTACHMENT_CHARS=12000

# API key ของผู้ให้บริการโมเดล (ชื่อผู้ให้บริการ + _API_KEY) ค่าใน .env มีผลก่อนค่าที่บันทึกในหน้าเว็บ
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=

# Client IP recording. Without a reverse proxy leave both unset (the web server records the socket address).
# Behind nginx/Caddy/a load balancer that sets X-Forwarded-For: set WEB_BEHIND_PROXY=1 and TRUSTED_PROXY_HOPS=2.
WEB_BEHIND_PROXY=0
TRUSTED_PROXY_HOPS=1

# What a DEPARTMENT_ADMIN may do (Super Admins always may). true/false, default true.
# Change the password of an internal account in their department:
DEPARTMENT_ADMIN_RESET_PASSWORD=true
# Manage users in their department (add, rename, suspend, quota, add/remove members).
# Setting this to false also turns off password resets, whatever the switch above says:
DEPARTMENT_ADMIN_MANAGE_USERS=false

# Languages the voice features may use (comma separated ISO codes). Default th,en.
VOICE_LANGUAGES=th,en

# Hours a temporary chat attachment is kept before the hourly cleanup deletes it
CHAT_ATTACHMENT_HOURS=24

# Agent mode: total tokens (all rounds of one question) after which the model must stop calling tools and answer
AGENT_MAX_TOKENS=60000

# How long a sign-in lasts, counted from the moment of signing in (hours; default 24, allowed 0.25 to 720).
# SESSION_HOURS=24
